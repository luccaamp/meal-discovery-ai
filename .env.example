# Opcional: índice oficial de catálogo para a API.
# O servidor lê o ambiente do processo; não carrega este arquivo automaticamente.
MEAL_CATALOG_INDEX=data/processed/singapore-catalog-v1.sqlite
# Planejamento: dados e API atual não dependem de LLM.
# Preencher localmente quando a integração com o provedor for implementada.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
