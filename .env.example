# Opcional: índice oficial de catálogo para a API.
# O servidor lê o ambiente do processo; não carrega este arquivo automaticamente.
MEAL_CATALOG_INDEX=data/processed/singapore-catalog-v1.sqlite
# Modelo local, após fetch_local_llm.py e inicialização do llama-server.
MEAL_SERVING_INDEX=data/processed/singapore-serving-v1.sqlite
LLM_PROVIDER=local
LLM_MODEL=meal-local
LOCAL_LLM_URL=http://127.0.0.1:8081
# Adaptador opcional OpenAI: definir LLM_PROVIDER=openai, LLM_MODEL e esta chave.
# Ainda não executado contra a API comercial. Nunca preencher no Git.
OPENAI_API_KEY=
